     private static boolean isInMethod(VariableDeclarator vd, MethodDeclaration md) {
         return vd.findAncestor(MethodDeclaration.class)
                 .map(m -> m == md)
                 .orElse(false);
     }
+
+    /**
+     * Returns true for object-instance declarations such as:
+     *
+     *     Dog d = new Dog();
+     *
+     * Object variables must retain their original names because the
+     * Java-to-COBOL OOP translation uses the variable name to resolve
+     * object field and method references.
+     */
+    private static boolean isObjectVariable(VariableDeclarator vd) {
+        return vd.getInitializer()
+                .map(initializer -> initializer instanceof ObjectCreationExpr)
+                .orElse(false);
+    }
